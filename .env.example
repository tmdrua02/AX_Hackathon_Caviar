# Copy to .env on the GCE VM. Never commit .env.
# IP-only HTTP test: http://YOUR_STATIC_EXTERNAL_IP
# Domain/HTTPS: demo.example.com (Caddy obtains and renews the certificate automatically)
SERVER_ADDRESS=http://YOUR_STATIC_EXTERNAL_IP

# Generate separate random values, for example: openssl rand -hex 32
DEMO_API_TOKEN=replace_with_a_long_random_demo_token
DB_USERNAME=sa
DB_PASSWORD=replace_with_a_long_random_database_password
# Normally leave these defaults unchanged. Override them to switch to restored volumes.
SERVER_DB_VOLUME=medassist-demo-server-db
RECORDINGS_VOLUME=medassist-demo-recordings

# These provider secrets are injected only into server containers, never into the Android source/APK.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
DATA_GO_KR_SERVICE_KEY=
DATA_GO_KR_SERVICE_KEY_ENCODED=true

# Conservative defaults for a single 4 GB VM.
AI_CORE_POOL_SIZE=1
AI_MAX_POOL_SIZE=2
AI_QUEUE_CAPACITY=8
AI_MAX_ATTEMPTS=2
AI_RETRY_BACKOFF_MS=1000
UPLOAD_MAX_FILE_SIZE=30MB
UPLOAD_MAX_REQUEST_SIZE=32MB
